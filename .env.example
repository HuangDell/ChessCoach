# Chess Review Coach local configuration.
# Copy this file to .env. Values already exported by the shell take precedence.

# Web runtime (the host must remain loopback-only).
CHESS_WEB_HOST=127.0.0.1
CHESS_WEB_PORT=8765
CHESS_WEB_OPEN=0

# Personal data and Stockfish. Leave commented to use automatic discovery/defaults.
# CHESSCOACH_DATA_DIR=/absolute/path/to/chess-review-coach-data
# STOCKFISH_PATH=/absolute/path/to/stockfish

# Player identity and optional platform integration.
# CHESS_USERNAME=your-lichess-username
# CHESS_CHESSCOM_USERNAME=your-chesscom-username
# CHESS_ALIASES=lichess:another-account,chesscom:another-account
# LICHESS_TOKEN=your-lichess-token

# Engine analysis.
CHESS_ANALYSIS_PRESET=balanced
CHESS_ENGINE_POOL_SIZE=2
CHESS_SWEEP_DEPTH=16
CHESS_DEEP_ANALYSIS_DEPTH=22
CHESS_DEEP_ANALYSIS_MULTIPV=3
CHESS_ENGINE_CACHE=1
CHESS_PERSONALIZE_HISTORY=1

# Bounded explanation provider (optional).
# CHESS_EXPLANATION_PROVIDER=openai-compatible
# CHESS_EXPLANATION_BASE_URL=https://api.example.com/v1
# CHESS_EXPLANATION_MODEL=your-model
# CHESS_EXPLANATION_API_KEY=your-api-key
# CHESS_EXPLANATION_LANGUAGE=zh-CN

# Chess Coach Agent (optional). Use OPENAI_API_KEY for the official OpenAI endpoint.
# Schema adapter only: openai, deepseek, generic. Unset: openai without a custom URL, generic with one.
# CHESS_AGENT_PROVIDER=deepseek
# CHESS_AGENT_MODEL=your-model
# OPENAI_API_KEY=your-openai-api-key
# CHESS_AGENT_DEBUG=1
# Context capacity: 0 selects 1000000 for deepseek-flash, 128000 otherwise.
# Override when your endpoint imposes a different limit.
# CHESS_AGENT_CONTEXT_TOKENS=0
# CHESS_AGENT_CONTEXT_TRIGGER_RATIO=0.9
# CHESS_AGENT_CONTEXT_TARGET_RATIO=0.6
# CHESS_AGENT_MAX_OUTPUT_TOKENS=8192
# CHESS_AGENT_SUMMARY_MAX_OUTPUT_TOKENS=8192

# For a certified custom Responses-compatible endpoint, use these instead.
# CHESS_AGENT_BASE_URL=https://api.example.com/v1
# CHESS_AGENT_API_KEY=your-api-key
